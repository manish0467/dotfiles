#!/bin/bash

# Get full file list
SONGS=$(mpc listall)
[ -z "$SONGS" ] && exit 1

# Rofi single-select
SELECTED=$(echo "$SONGS" | rofi -dmenu -i \
    -p "🎵 Play Song:" \
    -theme-str 'window {width: 80%; height: 60%;}' \
    -theme-str 'listview {columns: 3; lines: 15;}')

[ -z "$SELECTED" ] && exit 0

# Clear queue and play selected song
mpc clear
mpc add "$SELECTED"
mpc play

# Get currently playing track
CURRENT=$(mpc --format "%artist% - %title%" current)
[ -z "$CURRENT" ] && CURRENT=$(mpc current)

# Echo in terminal
echo "▶ Now Playing: $CURRENT"

# Desktop notification
notify-send "▶ Now Playing" "$CURRENT"

