#!/usr/bin/env bash
# Reads colors from Omarchy's current theme and rewrites ~/.config/rofi/themes/omarchy.rasi

THEME_FILE="$HOME/.config/omarchy/current/theme/alacritty.toml"
RASI="$HOME/.config/rofi/themes/omarchy.rasi"

# Parse hex colors from Omarchy's alacritty theme
get_color() {
    grep "^$1 = " "$THEME_FILE" 2>/dev/null | head -1 | sed "s/.*= ['\"]#\?//;s/['\"].*//" | tr '[:lower:]' '[:upper:]'
    
}

bg0=$(get_color "background")
fg0=$(get_color "foreground")
accent=$(get_color "selection-background")
urgent=$(grep "^palette = 1=" "$THEME_FILE" 2>/dev/null | head -1 | sed 's/.*=#//' | tr '[:lower:]' '[:upper:]')

# Fallback to Tokyo Night if parsing fails
[ -z "$bg0" ] && bg0="1a1b26"
[ -z "$fg0" ] && fg0="a9b1d6"
[ -z "$accent" ] && accent="7aa2f7"
[ -z "$urgent" ] && urgent="f7768e"

# Derive bg1/bg2 - slightly lighter than bg0
bg1=$(printf "%02x%02x%02x" \
    $(( 0x${bg0:0:2} + 0x0a )) \
    $(( 0x${bg0:2:2} + 0x0b )) \
    $(( 0x${bg0:4:2} + 0x10 )) 2>/dev/null) || bg1="24283b"
bg2=$(printf "%02x%02x%02x" \
    $(( 0x${bg0:0:2} + 0x14 )) \
    $(( 0x${bg0:2:2} + 0x16 )) \
    $(( 0x${bg0:4:2} + 0x22 )) 2>/dev/null) || bg2="2e3248"
fg1=$(get_color "cursor-color")
[ -z "$fg1" ] && fg1="c0caf5"

cat > "$RASI" << EOF
/* Omarchy-aware rofi theme — auto-generated by rofi-theme-sync */

* {
    bg0:     #${bg0,,};
    bg1:     #${bg1,,};
    bg2:     #${bg2,,};
    fg0:     #${fg0,,};
    fg1:     #${fg1,,};
    accent:  #${accent,,};
    urgent:  #${urgent,,};
    border:  #${accent,,};

    background-color:   transparent;
    text-color:         @fg0;
    border-color:       @border;
}

window {
    background-color:   @bg0;
    border:             2px;
    border-color:       @border;
    border-radius:      12px;
    padding:            0;
    width:              520px;
}

mainbox {
    background-color:   transparent;
    children:           [inputbar, listview];
    spacing:            0;
    padding:            12px;
}

inputbar {
    background-color:   @bg1;
    border-radius:      8px;
    padding:            10px 14px;
    margin:             0 0 10px 0;
    children:           [prompt, entry];
    spacing:            8px;
}

prompt {
    background-color:   transparent;
    text-color:         @accent;
    font:               "JetBrainsMono Nerd Font Bold 12";
}

entry {
    background-color:   transparent;
    text-color:         @fg1;
    placeholder:        "Search...";
    placeholder-color:  #4a5173;
}

listview {
    background-color:   transparent;
    lines:              8;
    columns:            1;
    spacing:            4px;
    scrollbar:          false;
}

element {
    background-color:   transparent;
    border-radius:      6px;
    padding:            8px 10px;
    spacing:            10px;
    children:           [element-icon, element-text];
}

element selected {
    background-color:   @bg2;
    text-color:         @fg1;
}

element-icon {
    background-color:   transparent;
    size:               20px;
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
    vertical-align:     0.5;
}

element urgent {
    text-color: @urgent;
}
EOF

echo "rofi theme synced to current Omarchy theme"
