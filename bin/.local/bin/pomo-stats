#!/bin/bash

LOG="$HOME/.local/state/pomodoro/log.csv"

[ ! -f "$LOG" ] && echo "No Pomodoro data yet." && exit 0
echo

awk -F, '
{
  days[$1] = 1
}
END {
  streak = 0
  for (i = 0; ; i++) {
    cmd = "date -d \"" i " days ago\" +%F"
    cmd | getline d
    close(cmd)
    if (days[d]) streak++
    else break
  }
  print "🔥 Current streak:", streak, "day(s)"
}' ~/.local/state/pomodoro/log.csv

echo
echo "=============================="
echo "📅 Weekly Summary (last 7 days)"
echo "=============================="

awk -F, -v cutoff="$(date -d '6 days ago' +%F)" '
$1 >= cutoff {
  sum[$1] += $2
}
END {
  for (d in sum)
    printf "%s | %.1fh\n", d, sum[d]/60
}' "$LOG" | sort

echo
echo "=============================="
echo "📊 Daily Focus Graph"
echo "=============================="

awk -F, '
NF==2 {
  sum[$1] += $2
}
END {
  for (d in sum) {
    hours = sum[d] / 60
    bars = int(sum[d] / 10)
    printf "%s | %4.1fh | ", d, hours
    for (i=0; i<bars; i++) printf "█"
    printf "\n"
  }
}' "$LOG" | sort

