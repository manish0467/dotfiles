/* Omarchy-aware rofi theme — auto-generated on theme change */

* {
    bg0:     #1a1b26;
    bg1:     #242636;
    bg2:     #2e3148;
    fg0:     #a9b1d6;
    fg1:     #c0caf5;
    accent:  #7aa2f7;
    urgent:  #f7768e;
    border:  #7aa2f7;

    background-color:   transparent;
    text-color:         @fg0;
    border-color:       @border;
}

window {
    background-color:   @bg0;
    border:             2px;
    border-color:       @border;
    border-radius:      12px;
    padding:            0;
    width:              520px;
}

mainbox {
    background-color:   transparent;
    children:           [inputbar, listview];
    spacing:            0;
    padding:            12px;
}

inputbar {
    background-color:   @bg1;
    border-radius:      8px;
    padding:            10px 14px;
    margin:             0 0 10px 0;
    children:           [prompt, entry];
    spacing:            8px;
}

prompt {
    background-color:   transparent;
    text-color:         @accent;
    font:               "JetBrainsMono Nerd Font Bold 12";
}

entry {
    background-color:   transparent;
    text-color:         @fg1;
    placeholder:        "Search...";
    placeholder-color:  #4a5173;
}

listview {
    background-color:   transparent;
    lines:              8;
    columns:            1;
    spacing:            4px;
    scrollbar:          false;
}

element {
    background-color:   transparent;
    border-radius:      6px;
    padding:            8px 10px;
    spacing:            10px;
    children:           [element-icon, element-text];
}

element selected {
    background-color:   @bg2;
    text-color:         @fg1;
}

element-icon {
    background-color:   transparent;
    size:               20px;
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
    vertical-align:     0.5;
}

element urgent {
    text-color: @urgent;
}
